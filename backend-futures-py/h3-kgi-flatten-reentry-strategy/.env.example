# 凱基登入身分證字號／登入 ID，不是期貨交易帳號。
KGI_LOGIN_ID=

# 凱基登入密碼；只填在本機 .env，不要提交 Git 或貼到聊天。
KGI_PASSWORD=

# 要下單的凱基期貨交易帳號，請保留前導零。
KGI_ACCOUNT=

# 期貨帳戶所屬分公司代碼，對應凱基帳戶清單的 broker_id；請保留前導零。
# 這是分公司代碼，與下方控制下單口數的 UNIT 不同。
KGI_BROKER_ID=

# 連線環境：true＝測試環境；false＝正式環境。
# 預覽不下單；以 --live 或服務 Start 啟動後，才會依此環境送單。
KGI_SIMULATION=true

# 每次新訊號先平掉實際庫存，再進場的微台口數；必須是大於零的整數。
# 例如設 3：B=1、S=0 時買進 3 口；B=0、S=1 時賣出 3 口。
# B／S 只決定方向，不會乘上訊號口數。修改後需重新啟動凱基策略才生效。
KGI_UNIT=1
