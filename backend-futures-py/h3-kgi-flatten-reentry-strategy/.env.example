# 凱基登入身分證字號／登入 ID，不是期貨交易帳號。
KGI_LOGIN_ID=

# 凱基登入密碼；只填在本機 .env，不要提交 Git 或貼到聊天。
KGI_PASSWORD=

# 要下單的凱基期貨交易帳號，請保留前導零。
KGI_ACCOUNT=

# 期貨帳戶所屬分公司代碼，對應凱基帳戶清單的 broker_id；請保留前導零。
# 這是分公司代碼，與下方控制下單口數的 UNIT 不同。
KGI_BROKER_ID=

# 連線環境：true＝測試環境；false＝正式環境。
# 預覽不下單；以 --live 或服務 Start 啟動後，才會依此環境送單。
KGI_SIMULATION=true

# 回撤加口版本固定填1：初始1口，已平倉回撤達3%後下一筆2口，回撤歸零後下一筆1口。
# B／S只決定方向；持倉不臨時補口，每次先確認平倉，再按更新後階段開新倉。
KGI_UNIT=1

# 每口單邊費稅的估算新台幣金額，預設24；每筆已平倉扣兩邊，2口按2倍計算。
# 尚無可靠實際費稅明細，因此通知會標示「估算淨利」。既有帳本啟用後不可直接變更。
KGI_MDD_ONE_WAY_COST_TWD=24

# Discord網址放在上一層 backend-futures-py/.env 的 DISCORD_KGI_H3_MDD_ADD_URL，勿複製至此。
