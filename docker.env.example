# Copy this file to `.env` at the repository root if you want compose to pass
# the Cloudflare tunnel token into the container.
#
# Do not commit the real token.
CLOUDFLARED_TOKEN=

# Discord webhooks
DISCORD_H_TRADE_WEBHOOK_URL=
DISCORD_SIX_STRATEGY_WEBHOOK_URL=
DISCORD_MXF_ALERT_WEBHOOK_URL=
DISCORD_EF_HYSTERESIS_AGAIN_WEBHOOK_URL=
DISCORD_EF_HYSTERESIS_TOTAL_BREAKOUT_WEBHOOK_URL=
DISCORD_EF_HYSTERESIS_AGAIN_WEBHOOK_URL=
DISCORD_EF_CLAMP_WEBHOOK_URL=
DISCORD_MXF_VALUE_WEBHOOK_URL=
API_KEY=
SECRET_KEY=
# Optional local backup source for the consultant strategy signal log.
# On Windows, use forward slashes, for example:
# CONSULTANT_SIGNAL_LOG_DIR=C:/Program Files (x86)/MR.AutoTrading/群益期貨顧問策略下單機/Log
CONSULTANT_SIGNAL_LOG_DIR=
CONSULTANT_SIGNAL_LOG_PATH=/external/consultant-log/Bridge_Lite_Signal.log
CONSULTANT_SIGNAL_LOG_ENCODING=cp950
EF_STRONG_MORNING_FLAT_ENABLE_ORDERS=false
DISCORD_ETF_CROSS=
